# Backend Server Config
PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/fieldops_access_test
JWT_SECRET=super_secret_jwt_key_fieldops_2026_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth Config
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Password Reset Flow Config
CLIENT_URL=http://localhost:5173
EMAIL_FROM=noreply@fieldops.com
# Optional SMTP config for reset emails (defaults to mock preview link mode if not set)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Frontend App Config (React Client)
VITE_API_BASE_URL=http://localhost:5001/api
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
